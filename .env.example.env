# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados
DB_PATH=./src/database/somar.db
DB_BACKUP_PATH=./src/database/backups
DB_BACKUP_INTERVAL_HOURS=6

# JWT
JWT_SECRET=altere-esta-chave-para-uma-string-aleatoria-de-no-minimo-32-caracteres
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:3000

# Upload
UPLOAD_DIR=./uploads/documentos
UPLOAD_MAX_SIZE_MB=10

# Backup
BACKUP_KEEP_DAYS=30

# Login
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15